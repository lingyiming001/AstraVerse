# Optional. Without these, the API explicitly returns a local rule-based reply.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# Local development only. Keep the API bound to 127.0.0.1.

# Optional absolute runtime data directory; defaults to repository .local/.
# ASTRAVERSE_DATA_DIR=/absolute/path/to/astraverse-data
